// firebase/rules/firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isClanMember(clanId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid));
    }

    function isClanLeader(clanId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid)).data.role
          == 'leader';
    }

    function isClanLeaderOrOfficer(clanId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid)).data.role
          in ['leader', 'officer'];
    }

    // clanTag must be null or 1–4 uppercase letters only.
    function validClanTag(tag) {
      return tag == null || (tag is string && tag.matches('^[A-Z]{1,4}$'));
    }

    function isClanOwner(clanId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/clans/$(clanId)).data.ownerId == request.auth.uid;
    }

    function isTournamentCreator(tournamentId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.creatorId == request.auth.uid;
    }

    function isMatchParticipant(tournamentId, matchId) {
      let matchData = get(/databases/$(database)/documents/tournaments/$(tournamentId)/matches/$(matchId)).data;
      return isSignedIn() &&
        (request.auth.uid == matchData.participant1Id || request.auth.uid == matchData.participant2Id);
    }

    // ─── /profiles/{userId} ───────────────────────────────────────────────────
    // Any authenticated user can read; only the owner can write.

    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);

      // ─── /profiles/{userId}/gameRecords/{recordId} ─────────────────────────

      match /gameRecords/{recordId} {
        allow read, write, delete: if isOwner(userId);
      }

      // ─── /profiles/{userId}/missions_daily/{dateKey} ───────────────────────
      // Daily personal missions. Only the owner can read; ALL writes go through
      // server actions (Admin SDK bypasses these rules). Clients must never
      // write here directly — the snapshotted reward values are the only
      // protection against retroactive tuning, and a client write could forge
      // them.
      match /missions_daily/{dateKey} {
        allow read:                if isOwner(userId);
        allow create, update, delete: if false;
      }

      // ─── /profiles/{userId}/missions_weekly/{weekKey} ──────────────────────
      // Same contract as missions_daily — owner reads, server-only writes.
      match /missions_weekly/{weekKey} {
        allow read:                if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    // ─── /usernames/{username} ────────────────────────────────────────────────

    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── /clanSlugs/{slug} ───────────────────────────────────────────────────

    match /clanSlugs/{slug} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ─── /clans/{clanId} ─────────────────────────────────────────────────────
    // Public clans are readable by any authenticated user.
    // Private clans are only readable by members.

    match /clans/{clanId} {
      allow read: if isSignedIn() &&
        (resource.data.isPublic == true || isClanMember(clanId));
      allow create: if isSignedIn();
      allow update: if isClanOwner(clanId) &&
        (
          !("clanTag" in request.resource.data.diff(resource.data).affectedKeys()) ||
          (isClanLeader(clanId) && validClanTag(request.resource.data.clanTag))
        );
      allow delete: if isClanOwner(clanId);

      // ─── /clans/{clanId}/members/{userId} ──────────────────────────────────

      match /members/{userId} {
        allow read: if isClanMember(clanId) || isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isClanLeaderOrOfficer(clanId);
        allow delete: if isOwner(userId) || isClanLeaderOrOfficer(clanId);
      }

      // ─── /clans/{clanId}/posts/{postId} ──────────────────────────────────
      // Members can read and create; only the author can update or delete.

      match /posts/{postId} {
        allow read: if isClanMember(clanId);
        allow create: if isClanMember(clanId);
        allow update: if isSignedIn() && request.auth.uid == resource.data.authorId;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.authorId;

        // ─── /clans/{clanId}/posts/{postId}/likes/{userId} ─────────────────

        match /likes/{userId} {
          allow read: if isSignedIn();
          allow write: if isOwner(userId);
          allow delete: if isOwner(userId);
        }
      }
    }

    // ─── /notifications/{userId}/items/{itemId} ───────────────────────────────
    // Only the owner can read or modify their own notifications.
    // Writes come from trusted server actions (Admin SDK bypasses these rules).

    match /notifications/{userId} {
      allow read, write: if false;

      match /items/{itemId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // ─── /tournaments/{tournamentId} ─────────────────────────────────────────

    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      // Enforce that the stored creatorId matches the authenticated user so a
      // client cannot create a tournament on behalf of someone else.
      allow create: if isSignedIn() &&
        request.resource.data.creatorId == request.auth.uid;
      allow update: if isTournamentCreator(tournamentId);
      allow delete: if isTournamentCreator(tournamentId);

      // ─── /tournaments/{tournamentId}/participants/{pid} ───────────────────

      match /participants/{pid} {
        allow read: if isSignedIn();
        allow create: if isOwner(pid);
        // Creator can update result/status but NOT payment fields.
        allow update: if isTournamentCreator(tournamentId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['paymentStatus', 'paidAmount', 'stripeSessionId']);
        allow delete: if isTournamentCreator(tournamentId);
      }

      // ─── /tournaments/{tournamentId}/matches/{matchId} ───────────────────

      match /matches/{matchId} {
        allow read: if isSignedIn();
        allow create: if isTournamentCreator(tournamentId);
        allow update: if isTournamentCreator(tournamentId) || isMatchParticipant(tournamentId, matchId);
        allow delete: if isTournamentCreator(tournamentId);
      }
    }
  }
}
