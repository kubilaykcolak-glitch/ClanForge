// firebase/rules/firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isClanMember(clanId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid));
    }

    function isClanLeader(clanId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid)).data.role
          == 'leader';
    }

    function isClanLeaderOrOfficer(clanId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid)).data.role
          in ['leader', 'officer'];
    }

    // clanTag must be null or 1–4 uppercase letters only.
    function validClanTag(tag) {
      return tag == null || (tag is string && tag.matches('^[A-Z]{1,4}$'));
    }

    function isClanOwner(clanId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/clans/$(clanId)).data.ownerId == request.auth.uid;
    }

    function isTournamentCreator(tournamentId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.creatorId == request.auth.uid;
    }

    function isMatchParticipant(tournamentId, matchId) {
      let matchData = get(/databases/$(database)/documents/tournaments/$(tournamentId)/matches/$(matchId)).data;
      return isSignedIn() &&
        (request.auth.uid == matchData.participant1Id || request.auth.uid == matchData.participant2Id);
    }

    // ─── /profiles/{userId} ───────────────────────────────────────────────────
    // Any authenticated user can read.
    //
    // Writes are split per-operation:
    //  - `create` is server-only (the registration flow writes through the
    //    Admin SDK with the canonical defaults — including isAdmin=false, xp=0,
    //    etc. — so we never trust a client to seed those fields).
    //  - `update` is owner-only AND restricted to a hard allowlist of cosmetic
    //    / identity fields. ALL privileged fields (isAdmin, xp, isVerified,
    //    bannedAt/By/Reason, tournamentsPlayed/Won, badges, title, clan*,
    //    isPrivate, lastClanLeaveAt) are server-only — they live behind admin
    //    server actions or system-side denormalisation. Before this allowlist
    //    a user could `updateDoc(/profiles/me, { isAdmin: true })` directly
    //    and elevate themselves.
    //  - `delete` is server-only (account-deletion flow).

    function isProfileFieldAllowed(keys) {
      return keys.hasOnly([
        // Identity
        'displayName', 'username',
        // Bio fields
        'bio', 'country',
        // External handles
        'steamUrl', 'xboxGamertag', 'psnId', 'discordTag', 'twitchUrl',
        // Cosmetic
        'avatarUrl', 'bannerUrl', 'backgroundId', 'backgroundImageUrl', 'accentColour',
        // Timestamp
        'updatedAt'
      ]);
    }

    // Profile-creation guard. The onboarding flow writes the initial doc
    // from the client; this rule pins the privilege/state fields to their
    // safe defaults so an attacker can't seed `isAdmin: true` on first write.
    function isSafeInitialProfile() {
      let d = request.resource.data;
      return d.isAdmin == false
          && d.isVerified == false
          && d.xp == 0
          && d.tournamentsPlayed == 0
          && d.tournamentsWon == 0
          // Moderation fields must not be present on first write.
          && !('bannedAt'     in d)
          && !('bannedBy'     in d)
          && !('bannedReason' in d)
          // Badges and title are awarded server-side; the doc starts empty.
          && !('badges' in d)
          && !('title'  in d);
    }

    match /profiles/{userId} {
      allow read:   if isSignedIn();
      allow create: if isOwner(userId) && isSafeInitialProfile();
      allow update: if isOwner(userId)
                       && isProfileFieldAllowed(
                            request.resource.data.diff(resource.data).affectedKeys()
                          );
      allow delete: if false;

      // ─── /profiles/{userId}/gameRecords/{recordId} ─────────────────────────

      match /gameRecords/{recordId} {
        allow read, write, delete: if isOwner(userId);
      }

      // ─── /profiles/{userId}/missions_daily/{dateKey} ───────────────────────
      // Daily personal missions. Only the owner can read; ALL writes go through
      // server actions (Admin SDK bypasses these rules). Clients must never
      // write here directly — the snapshotted reward values are the only
      // protection against retroactive tuning, and a client write could forge
      // them.
      match /missions_daily/{dateKey} {
        allow read:                if isOwner(userId);
        allow create, update, delete: if false;
      }

      // ─── /profiles/{userId}/missions_weekly/{weekKey} ──────────────────────
      // Same contract as missions_daily — owner reads, server-only writes.
      match /missions_weekly/{weekKey} {
        allow read:                if isOwner(userId);
        allow create, update, delete: if false;
      }

      // ─── /profiles/{userId}/integrations/{provider} ────────────────────────
      // Linked third-party game accounts (Riot, etc). Any authenticated user
      // can read so widgets render on public profiles. ALL writes go through
      // server actions which fetch live data from the third-party API — clients
      // must never write here directly because a forged write would let a user
      // claim a rank they didn't earn.
      match /integrations/{provider} {
        allow read:                if isSignedIn();
        allow create, update, delete: if false;
      }

      // ─── /profiles/{userId}/integrations_pending/{provider} ────────────────
      // Mid-flight ownership verification (profile-icon challenge). Owner-read
      // so the UI can poll its own pending state if needed; server-only write.
      match /integrations_pending/{provider} {
        allow read:                if isOwner(userId);
        allow create, update, delete: if false;
      }

      // ─── /profiles/{userId}/match_history/{matchId} ────────────────────────
      // Cached per-match summaries fetched from Riot's match-v5 API by the
      // server-side ingest. OWNER-ONLY read for v1 — we'll widen to public
      // when the spec adds a "show on public profile" toggle. ALL writes go
      // through Admin SDK from the ingest action; client writes blocked so
      // a user can't forge a match win or boosted KDA.
      match /match_history/{matchId} {
        allow read:                if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    // ─── /league_account_owners/{puuid} ───────────────────────────────────────
    // Global uniqueness lock for Riot PUUIDs. One PUUID can only be claimed by
    // one ClanForge profile. Any signed-in user can read (so we can show
    // "this account is already linked to <user>" hints); server-only writes
    // via Admin SDK inside a Firestore transaction.
    match /league_account_owners/{puuid} {
      allow read:                if isSignedIn();
      allow create, update, delete: if false;
    }

    // ─── /admin_audit/{id} ────────────────────────────────────────────────────
    // Immutable audit log of every privileged admin action. Readable only by
    // users with a role custom claim of admin or super_admin (we trust the
    // signed JWT — never the profiles.isAdmin mirror — for this read because
    // the audit log is itself part of the security boundary). All writes
    // come through server actions via the Admin SDK, which bypasses rules.
    function hasAdminClaim() {
      return isSignedIn() &&
        (request.auth.token.role == 'admin' || request.auth.token.role == 'super_admin');
    }
    match /admin_audit/{id} {
      allow read:                if hasAdminClaim();
      allow create, update, delete: if false;
    }

    // ─── /usernames/{username} ────────────────────────────────────────────────

    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── /clanSlugs/{slug} ───────────────────────────────────────────────────

    match /clanSlugs/{slug} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ─── /clans/{clanId} ─────────────────────────────────────────────────────
    // Public clans are readable by any authenticated user.
    // Private clans are only readable by members.

    match /clans/{clanId} {
      allow read: if isSignedIn() &&
        (resource.data.isPublic == true || isClanMember(clanId));
      allow create: if isSignedIn();
      allow update: if isClanOwner(clanId) &&
        (
          !("clanTag" in request.resource.data.diff(resource.data).affectedKeys()) ||
          (isClanLeader(clanId) && validClanTag(request.resource.data.clanTag))
        );
      allow delete: if isClanOwner(clanId);

      // ─── /clans/{clanId}/members/{userId} ──────────────────────────────────

      match /members/{userId} {
        allow read: if isClanMember(clanId) || isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isClanLeaderOrOfficer(clanId);
        allow delete: if isOwner(userId) || isClanLeaderOrOfficer(clanId);
      }

      // ─── /clans/{clanId}/clan_missions_daily/{dateKey} ─────────────────────
      // Lightweight clan-collaborative missions. Members can read; ALL writes
      // go through server actions (Admin SDK bypasses these rules). Clients
      // must never write here — the snapshotted reward values and contributor
      // counts are the only protections against retroactive tuning / abuse,
      // and a client write could forge them.
      match /clan_missions_daily/{dateKey} {
        allow read:                if isClanMember(clanId);
        allow create, update, delete: if false;
      }

      // ─── /clans/{clanId}/clan_missions_weekly/{weekKey} ────────────────────
      // Same contract as clan_missions_daily — member-read, server-only-write.
      match /clan_missions_weekly/{weekKey} {
        allow read:                if isClanMember(clanId);
        allow create, update, delete: if false;
      }

      // ─── /clans/{clanId}/posts/{postId} ──────────────────────────────────
      // Members can read and create. Clients can ONLY create regular posts —
      // posts with isAnnouncement == true must go through the server action
      // createClanAnnouncement (which uses the Admin SDK to bypass rules and
      // ALSO re-checks that the caller is the clan leader + enforces the 3
      // announcements per 24h rate limit). This is defence-in-depth so a
      // forged client write can't flip the flag.
      // Author can update / delete their own posts; the isAnnouncement flag
      // is locked once written (no rule lets a client update it).

      match /posts/{postId} {
        allow read: if isClanMember(clanId);
        allow create: if isClanMember(clanId) &&
          (!('isAnnouncement' in request.resource.data) ||
            request.resource.data.isAnnouncement == false);
        allow update: if isSignedIn() &&
          request.auth.uid == resource.data.authorId &&
          !('isAnnouncement' in request.resource.data.diff(resource.data).affectedKeys()) &&
          !('pinnedUntil'    in request.resource.data.diff(resource.data).affectedKeys());
        allow delete: if isSignedIn() && request.auth.uid == resource.data.authorId;

        // ─── /clans/{clanId}/posts/{postId}/likes/{userId} ─────────────────

        match /likes/{userId} {
          allow read: if isSignedIn();
          allow write: if isOwner(userId);
          allow delete: if isOwner(userId);
        }
      }
    }

    // ─── /notifications/{userId}/items/{itemId} ───────────────────────────────
    // Only the owner can read or modify their own notifications.
    // Writes come from trusted server actions (Admin SDK bypasses these rules).

    match /notifications/{userId} {
      allow read, write: if false;

      match /items/{itemId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // ─── /tournaments/{tournamentId} ─────────────────────────────────────────

    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      // Enforce that the stored creatorId matches the authenticated user so a
      // client cannot create a tournament on behalf of someone else.
      allow create: if isSignedIn() &&
        request.resource.data.creatorId == request.auth.uid;
      allow update: if isTournamentCreator(tournamentId);
      allow delete: if isTournamentCreator(tournamentId);

      // ─── /tournaments/{tournamentId}/participants/{pid} ───────────────────

      match /participants/{pid} {
        allow read: if isSignedIn();
        // SERVER-ONLY create. The previous `allow create: if isOwner(pid)`
        // let a client write the doc directly, bypassing
        // registerForTournament entirely — skipping the capacity / status /
        // rank / paywall guards. All participant docs now flow through the
        // server action via Admin SDK.
        allow create: if false;
        // Creator updates are restricted to a positive allowlist of fields.
        // Previously this was a negative list ("not paymentStatus / paidAmount /
        // stripeSessionId") which silently let new fields slip through — a
        // creator could rewrite seeds, status, dispute fields, custom keys,
        // anything not specifically blocklisted (audit finding M2). The
        // allowlist covers the legit operational fields the bracket UI
        // touches and nothing else.
        allow update: if isTournamentCreator(tournamentId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'seed', 'displayName', 'avatarUrl']);
        allow delete: if isTournamentCreator(tournamentId);
      }

      // ─── /tournaments/{tournamentId}/matches/{matchId} ───────────────────

      match /matches/{matchId} {
        allow read: if isSignedIn();
        allow create: if isTournamentCreator(tournamentId);
        // ONLY the creator can flip match fields from the client. The old
        // rule also allowed `isMatchParticipant` updates, which meant
        // either participant could client-side-write
        // `{ status:'complete', winnerId:my_uid }` directly and bypass
        // reportMatchResult's dispute / opponent-confirmation flow entirely
        // (audit finding M3). All participant-driven changes now flow
        // through the disputeMatch / reportMatchResult server actions via
        // Admin SDK, which gates winnerId to a real participant uid.
        allow update: if isTournamentCreator(tournamentId);
        allow delete: if isTournamentCreator(tournamentId);
      }
    }
  }
}
