// firebase/storage.rules
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helper functions ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isUnder5MB() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // ─── avatars/{userId}/ ────────────────────────────────────────────────────
    // Only that user can write; any authenticated user can read.

    match /avatars/{userId}/{fileName} {
      allow read:   if isSignedIn();
      allow write:  if isOwner(userId) && isUnder5MB() && isImage();
      allow delete: if isOwner(userId);
    }

    // ─── profile-banners/{userId}/ ────────────────────────────────────────────
    // Only that user can write; any authenticated user can read.

    match /profile-banners/{userId}/{fileName} {
      allow read:   if isSignedIn();
      allow write:  if isOwner(userId) && isUnder5MB() && isImage();
      allow delete: if isOwner(userId);
    }

    // ─── profile-backgrounds/{userId}/ ───────────────────────────────────────
    // Only that user can write; any authenticated user can read.

    match /profile-backgrounds/{userId}/{fileName} {
      allow read:   if isSignedIn();
      allow write:  if isOwner(userId) && isUnder5MB() && isImage();
      allow delete: if isOwner(userId);
    }

    // ─── clan-assets/{clanId}/ ────────────────────────────────────────────────
    // Any authenticated user can read; writes go through /api/upload (Admin SDK)
    // so this rule is a defence-in-depth fallback only.

    match /clan-assets/{clanId}/{fileName} {
      allow read:   if isSignedIn();
      allow write:  if isSignedIn() && isUnder5MB() && isImage();
      allow delete: if isSignedIn();
    }

    // ─── clan-posts/{clanId}/ ────────────────────────────────────────────────
    // Any authenticated user can read; same Admin SDK proxy note as above.

    match /clan-posts/{clanId}/{fileName} {
      allow read:   if isSignedIn();
      allow write:  if isSignedIn() && isUnder5MB() && isImage();
      allow delete: if isSignedIn();
    }

    // ─── tournament-banners/{tournamentId}/ ──────────────────────────────────
    // Any authenticated user can read; same Admin SDK proxy note as above.

    match /tournament-banners/{tournamentId}/{fileName} {
      allow read:   if isSignedIn();
      allow write:  if isSignedIn() && isUnder5MB() && isImage();
      allow delete: if isSignedIn();
    }
  }
}
