// firebase/firestore.indexes.json
{
  "indexes": [

    // ── clans ────────────────────────────────────────────────────────────────

    // Browse clans: gameFocus filter + recruting + newest first
    {
      "collectionGroup": "clans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "gameFocus",    "order": "ASCENDING"  },
        { "fieldPath": "isRecruiting", "order": "ASCENDING"  },
        { "fieldPath": "createdAt",    "order": "DESCENDING" }
      ]
    },

    // Dashboard recommended clans: isRecruiting filter + largest clans first
    {
      "collectionGroup": "clans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isRecruiting", "order": "ASCENDING"  },
        { "fieldPath": "memberCount",  "order": "DESCENDING" }
      ]
    },

    // Clans browse page: public clans by member count (no recruiting filter)
    {
      "collectionGroup": "clans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isPublic",    "order": "ASCENDING"  },
        { "fieldPath": "memberCount", "order": "DESCENDING" }
      ]
    },

    // Browse clans: public + recruiting + most members first (default sort)
    {
      "collectionGroup": "clans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isPublic",     "order": "ASCENDING"  },
        { "fieldPath": "isRecruiting", "order": "ASCENDING"  },
        { "fieldPath": "memberCount",  "order": "DESCENDING" }
      ]
    },

    // Game-hub Clans section: public + gameFocus filter + most members first.
    // Used by getClanList when the optional `gameFocus` param is set
    // (per-game hub at /games/<slug>/clans).
    {
      "collectionGroup": "clans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isPublic",    "order": "ASCENDING"  },
        { "fieldPath": "gameFocus",   "order": "ASCENDING"  },
        { "fieldPath": "memberCount", "order": "DESCENDING" }
      ]
    },

    // ── tournaments ──────────────────────────────────────────────────────────

    // Open / live / locked tabs: status filter + soonest first
    {
      "collectionGroup": "tournaments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status",   "order": "ASCENDING" },
        { "fieldPath": "startsAt", "order": "ASCENDING" }
      ]
    },

    // Game-hub Tournaments section: status + game filter + soonest first.
    // Used by getTournamentTab when the optional `game` param is set
    // (per-game hub at /games/<slug>/tournaments and the overview block).
    {
      "collectionGroup": "tournaments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status",   "order": "ASCENDING" },
        { "fieldPath": "game",     "order": "ASCENDING" },
        { "fieldPath": "startsAt", "order": "ASCENDING" }
      ]
    },

    // Completed tab: status filter + most recent first  ← was missing, caused the error
    {
      "collectionGroup": "tournaments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status",   "order": "ASCENDING"  },
        { "fieldPath": "startsAt", "order": "DESCENDING" }
      ]
    },

    // Dashboard active tournaments: status IN [...] + soonest first
    {
      "collectionGroup": "tournaments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status",   "order": "ASCENDING" },
        { "fieldPath": "createdAt","order": "DESCENDING" }
      ]
    },

    // Tournaments sort: prize (largest prize pool first)
    {
      "collectionGroup": "tournaments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status",     "order": "ASCENDING"  },
        { "fieldPath": "prizePool",  "order": "DESCENDING" }
      ]
    },

    // Tournaments sort: most participants first
    {
      "collectionGroup": "tournaments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status",           "order": "ASCENDING"  },
        { "fieldPath": "participantCount", "order": "DESCENDING" }
      ]
    },

    // Clans sort: newest first (isPublic filter + createdAt desc)
    {
      "collectionGroup": "clans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isPublic",  "order": "ASCENDING"  },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },

    // Clan name prefix search: isPublic filter + name range
    {
      "collectionGroup": "clans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isPublic", "order": "ASCENDING" },
        { "fieldPath": "name",     "order": "ASCENDING" }
      ]
    },

    // ── challenges ───────────────────────────────────────────────────────────

    // Active challenges by type (progress tracking lookup)
    {
      "collectionGroup": "challenges",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "type",   "order": "ASCENDING" }
      ]
    },

    // getClanActiveChallenges: active status + endAt asc
    {
      "collectionGroup": "challenges",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "endAt",  "order": "ASCENDING" }
      ]
    },

    // Challenges by season
    {
      "collectionGroup": "challenges",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "seasonId", "order": "ASCENDING" },
        { "fieldPath": "startAt",  "order": "DESCENDING" }
      ]
    },

    // ── xp_events (subcollection) ─────────────────────────────────────────────

    // getClanXpFeed: amount > 0, order by amount then createdAt desc
    {
      "collectionGroup": "xp_events",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "amount",    "order": "ASCENDING"  },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },

    // ── clan_points ───────────────────────────────────────────────────────────
    //
    // The weekly / monthly / totalPoints leaderboards used to live here as
    // single-field composite-index declarations, but Firestore now rejects
    // those at deploy time as "not necessary" — single-field indexes are
    // auto-managed via the Firebase Console's Single Field Index controls.
    // The leaderboard queries still work because Firestore creates the
    // single-field indexes automatically (ASC and, when needed, DESC).

    // ── notifications (subcollection) ─────────────────────────────────────────

    // Unread notifications per user
    {
      "collectionGroup": "items",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "read",      "order": "ASCENDING"  },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },

    // ── posts (clan posts subcollection) ──────────────────────────────────────

    // Clan announcement rate-limit query in createClanAnnouncement:
    //   .where("isAnnouncement","==",true).where("createdAt",">=",windowStart)
    // Needs the composite isAnnouncement + createdAt index. Per-clan scope
    // (COLLECTION, not COLLECTION_GROUP) because the query lives under a
    // specific /clans/{clanId}/posts collection.
    {
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isAnnouncement", "order": "ASCENDING"  },
        { "fieldPath": "createdAt",      "order": "ASCENDING"  }
      ]
    },

    // ── profiles ─────────────────────────────────────────────────────────────

    // Players page leaderboard: top XP (single-field — auto-indexed by Firestore,
    // listed here for explicitness and to cover the verified filter variant)
    {
      "collectionGroup": "profiles",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isVerified", "order": "ASCENDING"  },
        { "fieldPath": "xp",        "order": "DESCENDING" }
      ]
    },

    // Players page: public profiles ranked by XP
    // Required for: where("isPrivate","==",false).orderBy("xp","desc")
    {
      "collectionGroup": "profiles",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isPrivate", "order": "ASCENDING"  },
        { "fieldPath": "xp",       "order": "DESCENDING" }
      ]
    },

    // ── game_content ─────────────────────────────────────────────────────────

    // Public hub list query: gameSlug + type + status + publishedAt desc
    // (listPublishedContent in game-content.actions.ts).
    {
      "collectionGroup": "game_content",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "gameSlug",    "order": "ASCENDING"  },
        { "fieldPath": "type",        "order": "ASCENDING"  },
        { "fieldPath": "status",      "order": "ASCENDING"  },
        { "fieldPath": "publishedAt", "order": "DESCENDING" }
      ]
    },

    // Slug-uniqueness probe in uniqueSlug(): gameSlug + type + slug
    {
      "collectionGroup": "game_content",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "gameSlug", "order": "ASCENDING" },
        { "fieldPath": "type",     "order": "ASCENDING" },
        { "fieldPath": "slug",     "order": "ASCENDING" }
      ]
    }

  ],
  "fieldOverrides": [
    // Collection-group equality query on participants.userId used by:
    //   - admin.actions.ts (admin user-view: "what tournaments has this
    //     user joined")
    //   - tournament-list.actions.ts getMyActiveTournamentsForGame (the
    //     LoL hub Overview's "Your tournaments" block)
    // Firestore does NOT auto-create COLLECTION_GROUP scope on
    // single-field indexes — without this override the queries throw
    // FAILED_PRECONDITION at runtime. We also explicitly keep the
    // COLLECTION scope entries here because declaring `indexes` replaces
    // auto-managed single-field indexes.
    {
      "collectionGroup": "participants",
      "fieldPath":       "userId",
      "indexes": [
        { "order": "ASCENDING",  "queryScope": "COLLECTION" },
        { "order": "DESCENDING", "queryScope": "COLLECTION" },
        { "order": "ASCENDING",  "queryScope": "COLLECTION_GROUP" }
      ]
    },

    // Collection-group equality query on integrations.provider used by:
    //   - src/lib/riot/ladder.ts getLeagueLadder (LoL hub Ladder section)
    // Firestore does NOT auto-create COLLECTION_GROUP scope on single-field
    // indexes — without this override the ladder query throws
    // FAILED_PRECONDITION at runtime and the section renders empty.
    {
      "collectionGroup": "integrations",
      "fieldPath":       "provider",
      "indexes": [
        { "order": "ASCENDING",  "queryScope": "COLLECTION" },
        { "order": "ASCENDING",  "queryScope": "COLLECTION_GROUP" }
      ]
    }
  ]
}
