# ─── Firebase (client) ────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (server-only) ─────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Stripe (paid tournaments) ────────────────────────────────────────────────
# Test mode keys for development — use sk_test_… and pk_test_….
# Webhook secret is printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── App URL ──────────────────────────────────────────────────────────────────
# Used as the base for Stripe Checkout success/cancel redirects.
# In local dev: http://localhost:3000
# In Vercel:   set to your production domain (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cron (vercel.json) ───────────────────────────────────────────────────────
# Shared secret used to authenticate Vercel Cron requests against
# /api/cron/* routes. Generate with: openssl rand -hex 32
# Vercel automatically injects this as `Authorization: Bearer <CRON_SECRET>`
# on cron runs.
CRON_SECRET=

# ─── Discord — Wanted/Bounty webhooks ─────────────────────────────────────────
# All three vars are SECRETS — no NEXT_PUBLIC_ prefix; never imported into a
# client component. Used by src/lib/discord/webhooks.ts to notify the
# community Discord on bounty lifecycle events.
#
# How to get the webhook URLs:
#   1. In your Discord server, open the channel settings cog → Integrations
#      → Webhooks → New Webhook → copy the URL.
#   2. Make one webhook per channel:
#      - #bounty-board   (public announcements: publish, claim approved)
#      - #bounty-mod-log (mod-only audit: claim opened, rejected, cancelled)
#   3. The URL looks like:
#        https://discord.com/api/webhooks/<id>/<token>
DISCORD_BOUNTY_BOARD_WEBHOOK_URL=
DISCORD_BOUNTY_MOD_LOG_WEBHOOK_URL=

# Optional — opt-in @-role ping on `published` events. Members self-assign
# this role in Discord to subscribe to "new bounty" announcements.
# How to get the ID:
#   Discord → User Settings → Advanced → enable Developer Mode →
#   right-click the role in Server Settings → Copy Role ID.
# Leave blank to disable role pings.
DISCORD_BOUNTY_HUNTER_ROLE_ID=

# Existing — Discord ticket URL surfaced as the "Submit a bounty" CTA on
# /games/arc-raiders/wanted. Safe to expose to the client (it's a public
# Discord invite/ticket-bot URL anyway).
NEXT_PUBLIC_DISCORD_BOUNTY_TICKET_URL=

# Optional — used as the base for deep-links inside Discord webhook embeds
# (e.g. https://clanforge.gg/games/arc-raiders/wanted#bounty-<id>).
# Defaults to https://clanforge.gg if unset.
NEXT_PUBLIC_SITE_ORIGIN=
